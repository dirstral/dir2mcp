# WIP — one piece remaining (go.vendors). dir2mcp MacPorts Portfile (lean), #273.
#
# Reference/starting Portfile for distributing the lean `dir2mcp` binary via
# MacPorts (build-from-source), primarily for older macOS where Homebrew no
# longer ships support. It builds locally with MacPorts' Go toolchain (pure Go,
# CGO disabled), so it works on the OS versions MacPorts targets.
#
# Targets v0.8.0. Already filled: go.setup, the verified source `checksums`, and
# the hand-tuned lean build / version ldflag / cmd/dir2mcp subpackage / smoke
# test / meta (none of which go2port produces).
#
# REMAINING before it builds / can be submitted to macports-ports:
#   1. the `go.vendors { ... }` block (every dependency + checksum) — generate it
#      against v0.8.0 with go2port on a MacPorts host:
#        go install github.com/sebres/go2port@latest   # or a maintained fork
#        go2port -o Portfile.gen github.com/dirstral/dir2mcp v0.8.0
#      then paste its `go.vendors { ... }` here (ignore its build/meta/checksums).
#   2. a real `maintainers` handle (below).
#
# Then validate on a MacPorts host:
#   port lint --nitpick ./Portfile
#   sudo port -v test ./Portfile

PortSystem          1.0
PortGroup           golang 1.0

# TODO(go2port): replace with the generated go.setup for the chosen tag.
go.setup            github.com/dirstral/dir2mcp 0.8.0 v

# TODO(go2port): paste the generated go.vendors { ... } block here.

name                dir2mcp
categories          textproc devel
platforms           darwin
license             MIT
# TODO: set your MacPorts maintainer handle.
maintainers         {github.com:REPLACE-with-your-handle} openmaintainer

description         Deploy a local directory as an MCP knowledge server (lean binary)
long_description    dir2mcp turns any local directory into a Model Context \
                    Protocol knowledge server with indexing, retrieval, and \
                    citations. This is the lean build; structured PDF/image \
                    extraction via docling is optional (bring-your-own, \
                    docling-serve, or Mistral OCR).

homepage            https://github.com/dirstral/dir2mcp

# Source tarball checksums for the v0.8.0 GitHub tag archive (verified). If you
# bump go.setup to a newer tag, regenerate these (port checksum / go2port).
checksums           rmd160  90cb908ce63f7fe06cbac5b9757102f6747d0762 \
                    sha256  0cb633d5ab891366c92720071c55541330e45496b181b020be3b634635ea778a \
                    size    5259535

# Lean, pure-Go build: no CGO and no bundled docling runtime. The version is
# injected into the symbol the runtime reads (internal/buildinfo.Version),
# mirroring .goreleaser.yaml and the Makefile.
build {
    system -W ${worksrcpath} \
        "CGO_ENABLED=0 ${go.bin} build \
            -ldflags \"-s -w -X github.com/dirstral/dir2mcp/internal/buildinfo.Version=v${version}\" \
            -o ${name} ./cmd/dir2mcp"
}

destroot {
    xinstall -m 0755 ${worksrcpath}/${name} ${destroot}${prefix}/bin/${name}
}

# Smoke check: the built binary runs. dir2mcp has no `help` subcommand, so use
# `version` (printing usage on no-args would exit non-zero).
test.run            yes
test {
    system "${destroot}${prefix}/bin/${name} version"
}
